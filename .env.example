PORT=3220
HOST=0.0.0.0
DATA_DIR=./data

# Jira 服务端直连（拖动回写 Target / 导入 Task；留空则功能自动降级禁用）
JIRA_BASE_URL=https://jira.ringcentral.com
JIRA_PAT=
JIRA_FIELD_TARGET_START=customfield_18350
JIRA_FIELD_TARGET_END=customfield_18351
# Roadmap 服务端 AI 批量规划（关闭时不影响手动创建 / MCP 结构化提交）
ROADMAP_AI_ENABLED=false
# 预览 vs 直接创建 Draft 由网页「生成」旁的勾选决定，不再用服务端开关
# 生成成功后可直接「撤销本批」；不按环境变量开关，也不拦截「创建 Jira」
ROADMAP_AI_AGENT_ACCESS=true
ROADMAP_LLM_PROVIDER=openai
ROADMAP_OPENAI_API_KEY=
ROADMAP_OPENAI_API_BASE_URL=https://api.openai.com/v1
ROADMAP_OPENAI_MODEL=gpt-4.1
ROADMAP_OPENAI_API_MODE=chat_completions
ROADMAP_OPENAI_OUTPUT_MODE=json_schema
ROADMAP_CLAUDE_API_KEY=
ROADMAP_CLAUDE_MODEL=claude-sonnet-4-5
ROADMAP_PUBLIC_BASE_URL=http://roadmap.xmnup.com
# 远程 MCP 为 {ROADMAP_PUBLIC_BASE_URL}/mcp；不配则默认 http://roadmap.xmnup.com

